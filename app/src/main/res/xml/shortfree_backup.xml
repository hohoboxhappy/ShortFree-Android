<?xml version="1.0" encoding="utf-8"?>
<!-- 사용자의 기기별 동의와 설정을 백업 및 기기 간 이전에서 제외합니다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
