<?xml version="1.0" encoding="utf-8"?>
<!-- 좁은 가로 화면과 큰 글꼴에서도 차단 안내와 돌아가기 버튼에 접근할 수 있게 한다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="Overdraw"
    android:id="@+id/block_content"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/canvas" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="28dp" android:gravity="center" android:orientation="vertical">
        <ImageView
            android:layout_width="56dp" android:layout_height="56dp"
            android:importantForAccessibility="no" android:src="@drawable/ic_shield" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center"
            android:text="@string/blocked" android:textColor="@color/ink"
            android:textSize="28sp" android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:maxWidth="380dp" android:gravity="center"
            android:text="@string/blocked_body" android:textColor="@color/ink" android:textSize="17sp" />
        <Button
            android:id="@+id/return_button"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:minHeight="56dp"
            android:paddingStart="24dp" android:paddingEnd="24dp"
            android:backgroundTint="@color/action" android:textColor="@color/on_action"
            android:text="@string/go_back" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
